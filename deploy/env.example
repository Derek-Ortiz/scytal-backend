# Copia este archivo a /opt/scytal/.env en la EC2 y llena los valores.
# NUNCA lo subas al repositorio.
#
# Genera secretos con:  openssl rand -hex 32   (o Fernet para TOTP_ENCRYPTION_KEY)

# Imagen que usa el contenedor api; la actualiza GitHub Actions en cada despliegue.
API_IMAGE=ghcr.io/USUARIO/scytal-backend:CAMBIAR

# --- PostgreSQL ---
POSTGRES_DB=CAMBIAR
POSTGRES_USER=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR

# --- URLs de conexión (dentro de Docker Compose usan los nombres de servicio) ---
DATABASE_URL=postgresql+asyncpg://CAMBIAR@db:5432/CAMBIAR
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=CAMBIAR
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_PENDING_EXPIRE_MINUTES=5

# --- 2FA TOTP (clave Fernet base64 de 32 bytes) ---
TOTP_ENCRYPTION_KEY=CAMBIAR

# --- Correo ---
# EMAIL_PROVIDER=ses  -> Amazon SES por API. No lleva llaves: usa el rol de la EC2
#                        (LabInstanceProfile). El remitente debe estar verificado en SES.
# EMAIL_PROVIDER=smtp -> cualquier SMTP (Brevo, Gmail, SendGrid...) con las variables SMTP_*.
EMAIL_PROVIDER=ses
EMAIL_FROM=CAMBIAR
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=

# --- SMTP (solo si EMAIL_PROVIDER=smtp; MailHog solo corre en dev) ---
SMTP_HOST=CAMBIAR
SMTP_PORT=587
SMTP_FROM=CAMBIAR
SMTP_USER=CAMBIAR
SMTP_PASSWORD=CAMBIAR
SMTP_USE_TLS=true
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=2
SMTP_BULK_DELAY_SECONDS=1

# --- URLs públicas (usadas en los enlaces de los correos) ---
PUBLIC_BASE_URL=CAMBIAR
FRONTEND_BASE_URL=CAMBIAR

# --- HIBP (Have I Been Pwned) ---
HIBP_API_URL=https://api.pwnedpasswords.com/range/
HIBP_CACHE_TTL_SECONDS=3600

# --- CORS: origen exacto del frontend, con https:// ---
CORS_ALLOWED_ORIGINS=CAMBIAR

# --- Admin de plataforma inicial (seed idempotente).
# La contraseña debe cumplir §5: 10+ caracteres, zxcvbn >= 3, no estar en HIBP. ---
PLATFORM_ADMIN_EMAIL=CAMBIAR
PLATFORM_ADMIN_PASSWORD=CAMBIAR
