# Copiar a .env y completar. NUNCA versionar .env con secretos reales.
DATABASE_URL=postgresql+asyncpg://scytal:scytal_pass@db:5432/scytal
REDIS_URL=redis://redis:6379/0

JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_PENDING_EXPIRE_MINUTES=5

TOTP_ENCRYPTION_KEY=     # clave Fernet base64 de 32 bytes: generar con `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=remitente-verificado@tu-dominio.com

PUBLIC_BASE_URL=http://localhost:8000

HIBP_API_URL=https://api.pwnedpasswords.com/range/
HIBP_CACHE_TTL_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin de plataforma inicial (seed). La contraseña debe cumplir las reglas §5 (10+ chars, zxcvbn>=3, no HIBP).
PLATFORM_ADMIN_EMAIL=admin@scytal.local
PLATFORM_ADMIN_PASSWORD=CambiaEstaClave123!

# Proveedor de correo: smtp (MailHog/Brevo/Gmail/...) o ses (Amazon SES por API, credenciales por rol IAM).
EMAIL_PROVIDER=smtp
EMAIL_FROM=
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=

# Correo (SMTP). En dev: MailHog (SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_USE_TLS=false, sin credenciales).
# En produccion: MailerSend. Usuario y clave se generan en el panel (Domains > SMTP users).
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_FROM=no-reply@tu-dominio-verificado
SMTP_USER=usuario-smtp-aqui
SMTP_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_SMTP
SMTP_USE_TLS=true
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=2
SMTP_BULK_DELAY_SECONDS=1

# URL del frontend para enlaces en correos (invitación de analista, feedback de campañas)
FRONTEND_BASE_URL=http://localhost:3000
